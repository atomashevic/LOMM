{
  "schema_version": 1,
  "revision": "revision-v2",
  "acknowledgement": "LONG-RUNS-AUTHORIZED",
  "defaults": {
    "output_root": "simulation_outputs/revision_v2",
    "status_history": "simulation_outputs/revision_v2/status_history.jsonl",
    "lock_root": "simulation_outputs/revision_v2/.locks",
    "max_workers": 24,
    "max_heavy_jobs": 1,
    "stall_after_seconds": 1800,
    "config_hash_length": 12,
    "tmux_prefix": "lomm-revision",
    "checkpoint_file": "checkpoint_results.csv",
    "dry_run_manifest": "dry_run_manifest.json",
    "prospective_manifest": "prospective_manifest.json",
    "run_manifest": "run_manifest.json",
    "success_marker": "_SUCCESS.json",
    "failure_marker": "_FAILED.json",
    "exit_code_file": "exit_code.txt",
    "run_log": "run.log",
    "job_contract": {
      "seed_policy": {
        "origin": 20260715,
        "derivation": "seed = 1 + (origin + stable_base131_hash(pair_key)) mod 2147483646",
        "method_independent_pair_keys": true,
        "matched_horizons_share_pair_keys": true,
        "challenge_variants_share_pair_keys": true
      },
      "config_hash_policy": {
        "algorithm": "sha256",
        "length": 12,
        "inputs": [
          "schema_version",
          "revision",
          "job_except_description_and_stage",
          "resolved_job_contract",
          "recursive_dependency_hashes"
        ]
      },
      "path_templates": {
        "output_dir": "simulation_outputs/revision_v2/{job_id}/{config_hash}",
        "checkpoint": "{output_dir}/checkpoint_results.csv",
        "dry_run_manifest": "{output_dir}/dry_run_manifest.json",
        "prospective_manifest": "{output_dir}/prospective_manifest.json",
        "run_manifest": "{output_dir}/run_manifest.json",
        "run_log": "{output_dir}/run.log",
        "success_marker": "{output_dir}/_SUCCESS.json",
        "failure_marker": "{output_dir}/_FAILED.json",
        "exit_code": "{output_dir}/exit_code.txt"
      },
      "tmux_name_template": "lomm-revision-{job_id}-{config_hash_prefix8}",
      "resume_policy": {
        "automatic": false,
        "explicit_resume_command_required": true,
        "checkpoint_first": true,
        "fresh_launch_refuses_existing_checkpoint": true,
        "append_run_log": true
      },
      "final_validation_conditions": [
        "no_failure_marker",
        "prospective_manifest_matches_locked_config",
        "run_manifest_status_complete_and_matches_locked_command",
        "observed_unique_units_match_expected_units",
        "configured_panel_counts_match_checkpoint_and_final_results",
        "all_expected_output_hashes_match",
        "success_marker_schema_is_exact"
      ]
    }
  },
