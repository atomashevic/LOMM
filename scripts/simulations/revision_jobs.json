        "budget_seconds": null,
        "external_required_inputs": [
          "required_at_execution:MAFW-derived frame_scores.csv"
        ]
      },
      "required_dependencies": [],
      "optional_dependencies": [],
      "parameters": {
        "analysis": "empirical_cv"
      },
      "expected_train_units": 13500,
      "expected_heldout_units": 500,
      "expected_units": 14000,
      "command": [
        "Rscript",
        "scripts/simulations/run_revision_job.R",
        "--job",
        "empirical_cv",
        "--config",
        "scripts/simulations/revision_jobs.json"
